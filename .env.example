# 智谱 AI 开放平台 API Key（仅服务端使用，不会打包进前端）
# 获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 使用的模型，默认 glm-4-flash-250414（免费额度可用，长 JSON 生成更快）
# 也可换 glm-4-air（更快）/ glm-4.6（更强推理，但更慢）
ZHIPU_MODEL=glm-4-flash-250414

# —— 做菜视频搜索（全部可选，不配置也能用） ——
# 单次平台请求超时（毫秒，默认 8000，范围 2000–20000）
# VIDEO_SEARCH_TIMEOUT_MS=8000
# 搜索结果内存缓存时长（毫秒，默认 600000 = 10 分钟）
# VIDEO_SEARCH_CACHE_TTL_MS=600000
# 可选：手动指定 B 站匿名会话 Cookie（默认自动访问一次主页获取 buvid3，无需登录）
# BILIBILI_COOKIE=
